{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "oh-my-blog",
  "compatibility_date": "2026-02-25",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "main": "./worker/index.ts",
  "assets": {
    "not_found_handling": "none",
    "binding": "ASSETS"
  },
  "images": {
    "binding": "IMAGES"
  },
  "kv_namespaces": [
    {
      "binding": "BLOG_POSTS",
      "id": "171ad16ab08a440ca6d5c96b7b7df66d"
    }
  ]
}
